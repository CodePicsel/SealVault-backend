NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://localhost:27017/sealvault          # replace "myapp" with your DB name
JWT_SECRET=put_a_long_random_secret_here
JWT_EXPIRES=1h
BCRYPT_SALT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=6000
RATE_LIMIT_MAX=10
REFRESH_TOKEN_EXPIRES_DAYS=30
CLIENT_ORIGIN=http://localhost:5173

SUPABASE_URL=https://xxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_BUCKET=your-bucket-name
MAX_UPLOAD_SIZE=10485760 #10MB upload limit.

GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=yyyyy

# Signing workflow
SIGN_TOKEN_PEPPER=put_another_long_random_secret_here
SIGNATURE_MAX_BYTES=2097152
SIGN_PUBLIC_RATE_LIMIT_WINDOW_MS=60000
SIGN_PUBLIC_RATE_LIMIT_MAX=30
SIGNING_LINK_BASE_URL=http://localhost:5173
APP_BASE_URL=http://localhost:5173
AUDIT_TOKEN_EXPIRES_DAYS=30
JSON_BODY_LIMIT=5mb

# Email (Nodemailer SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
EMAIL_FROM=no-reply@example.com
